        "text": "兩個方法。第一、換關鍵字試試看：可能網路討論區的標題用法跟你印象中的字眼不太一樣（例如你記得「無語」、文章可能寫「傻眼」），多試幾個同義詞或當時的流行用語。第二、用首頁右上角「意見回饋」直接告訴我們、附上你大概記得的內容（什麼動物、什麼情緒、大概什麼時候看到的）、我們會手動補進資料庫。早期版本資料量還在累積、回饋對改進很有用。"
      }
    }
  ]
}
</script>

<footer class="site-footer">
  © 2026 TWmeme · 台灣繁中迷因搜尋（早期版本）
</footer>

<div class="toast" id="toast"></div>

<!-- Neon HTTP driver loaded lazily via dynamic import inside db.js -->
<!-- (web_anon DB creds in db.js are GRANT-restricted, public-safe) -->
<script src="db.js"></script>
<script src="render.js"></script>

<script>
  function goResults() {
    const q = document.getElementById('q').value.trim();
    if (!q) return;
    location.href = 'results.html?q=' + encodeURIComponent(q);
  }

  // Client-side fallback: if SSG didn't inject cards, load from DB
  async function loadGridFallback(gridId, queryFn) {
    const grid = document.getElementById(gridId);
    if (!grid || grid.children.length > 0) return;
    const memes = await queryFn();
    if (memes && memes.length > 0) {
      window.TWmeme.render.renderGrid(grid, memes);
    }
  }

  async function loadAllGrids() {
    const supa = window.TWmeme?.supa;
    if (!supa) return;
    await Promise.allSettled([
      loadGridFallback('weekly-hot-grid', () => supa.getWeeklyHotMemes(8)),
      loadGridFallback('popular-grid', () => supa.getPopularMemes(8)),
      loadGridFallback('latest-grid', () => supa.getLatestMemes(8)),
    ]);
  }

  async function loadHeroCount() {
    const sub = document.getElementById('hero-sub');
    if (sub && sub.textContent.includes('目前') && /\d+/.test(sub.textContent)) return;
    const n = await window.TWmeme.supa.getMemeCount();
    if (typeof n === 'number' && n > 0) {
      sub.textContent = `早期版本、目前收錄 ${n.toLocaleString('en')} 張迷因梗圖。搜不到的告訴我們、會補上。`;
    }
  }

  loadAllGrids();
  loadHeroCount();
</script>
</body>
</html>
